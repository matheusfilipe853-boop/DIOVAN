{
  "name": "DIOVAN — 06 Esteira LinkedIn (planilha → busca → Claude)",
  "nodes": [
    {
      "id": "sched",
      "name": "Diário 09h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "read",
      "name": "Ler ideias (Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        400,
        300
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "options": {}
      },
      "notes": "CONFIGURAR: credencial Google Sheets + planilha de ideias. Colunas: id, ideia, keywords_busca, status, data_para_post, post_id, data_publicada, post_gerado"
    },
    {
      "id": "filter",
      "name": "Filtrar pendentes",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        620,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "naopostado",
              "leftValue": "={{ ($json.status || '').toLowerCase() }}",
              "rightValue": "postado",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "dataok",
              "leftValue": "={{ $json.data_para_post }}",
              "rightValue": "={{ $now.toFormat('yyyy-MM-dd') }}",
              "operator": {
                "type": "string",
                "operation": "le"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "limit",
      "name": "Um por vez",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        820,
        300
      ],
      "parameters": {
        "maxItems": 1
      }
    },
    {
      "id": "search",
      "name": "Pesquisa (DDGS via API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DIOVAN_API_URL || 'http://127.0.0.1:5680' }}/search",
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"query\": {{ JSON.stringify($json.keywords_busca || $json.ideia) }}, \"max_results\": 5 }",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "claude",
      "name": "Gerar post (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 1300,\n  \"messages\": [{\n    \"role\": \"user\",\n    \"content\": {{ JSON.stringify(\"Voce e o estrategista de conteudo do My Fitness Suite (mfSuite!), SaaS de gestao financeira para personal trainers e consultores fitness no Brasil. Escreva UM post para LinkedIn (max 1300 caracteres, tom direto, gancho forte na 1a linha, termine com pergunta que gere comentario, sem hashtags em excesso). Foque em dor real de gestao (cobranca, inadimplencia, planilha, organizacao de alunos).\\n\\nIDEIA/BRIEFING: \" + ($('Filtrar pendentes').item.json.ideia || \"\") + \"\\n\\nCONTEXTO DE PESQUISA (use se relevante, nao copie literalmente):\\n\" + JSON.stringify($json.results || []) + \"\\n\\nResponda APENAS com o texto final do post, sem titulo nem aspas.\") }}\n  }]\n}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "approve",
      "name": "Aprovação Telegram (Fase 1)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"chat_id\": \"{{ $env.TELEGRAM_CHAT_ID }}\", \"text\": {{ JSON.stringify(\"📝 Post pronto p/ \" + ($('Filtrar pendentes').item.json.data_para_post || \"hoje\") + \" (ideia: \" + ($('Filtrar pendentes').item.json.id || \"?\") + \")\\n\\n\" + $json.content[0].text + \"\\n\\n— revise e publique no LinkedIn\") }} }"
      },
      "notes": "FASE 1: rascunho pro Telegram (sem esperar app review LinkedIn). FASE 2: trocar por nó LinkedIn 'Create Post' e usar o post_id retornado."
    },
    {
      "id": "update",
      "name": "Marcar postado (Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "id"
          ],
          "value": {
            "id": "={{ $('Filtrar pendentes').item.json.id }}",
            "status": "postado",
            "data_publicada": "={{ $now.toFormat('yyyy-MM-dd') }}",
            "post_gerado": "={{ $('Gerar post (Claude)').item.json.content[0].text }}"
          }
        },
        "options": {}
      },
      "notes": "FASE 2: adicionar post_id = id retornado pelo LinkedIn. Match pela coluna 'id'."
    }
  ],
  "connections": {
    "Diário 09h": {
      "main": [
        [
          {
            "node": "Ler ideias (Sheets)",
            "type": "main",
