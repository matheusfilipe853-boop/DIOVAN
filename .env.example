# Copie este arquivo para .env e preencha com seus dados
# cp .env.example .env

# LLM
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# GitHub (Personal Access Token)
# Gere em: github.com → Settings → Developer Settings → Personal access tokens
GITHUB_TOKEN=seu_token_aqui
GITHUB_REPO=seu_usuario/nome-do-repositorio

# Memória
MEMORY_MODE=local

# APIs externas (opcional - para modo cloud)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
