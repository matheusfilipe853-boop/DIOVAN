# n8n — Configuração DIOVAN
# Copie para .env.n8n e preencha os valores

# Servidor
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Autenticação básica (acesso à UI)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=diovan
N8N_BASIC_AUTH_PASSWORD=diovan2026

# Timezone
GENERIC_TIMEZONE=America/Sao_Paulo

# Banco de dados (sqlite local)
DB_TYPE=sqlite

# Diretório de dados do n8n (dados ficam dentro do projeto, isolados)
N8N_USER_FOLDER=/home/dev-matheus/Documentos/diovan/n8n/data

# DIOVAN
DIOVAN_DIR=/home/dev-matheus/Documentos/diovan
DIOVAN_API_URL=http://127.0.0.1:5680

# Telegram (preencha para receber notificações)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic (esteira de conteúdo LinkedIn — workflow 06)
ANTHROPIC_API_KEY=

# Webhook (URL base para webhooks)
WEBHOOK_URL=http://localhost:5678/
