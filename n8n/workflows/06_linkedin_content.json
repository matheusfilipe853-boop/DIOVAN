            "index": 0
          }
        ]
      ]
    },
    "Um por vez": {
      "main": [
        [
          {
            "node": "Pesquisa (DDGS via API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pesquisa (DDGS via API)": {
      "main": [
        [
          {
            "node": "Gerar post (Claude)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gerar post (Claude)": {
      "main": [
        [
          {
            "node": "Aprovação Telegram (Fase 1)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aprovação Telegram (Fase 1)": {
